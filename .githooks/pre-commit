#!/bin/sh
# Auto-generate build artefacts when their sources change, then stage them.
# Activated via `git config core.hooksPath .githooks` (run by `npm install`).

# What changed in this commit (added/copied/modified/renamed/deleted)?
blog_changed=$(git diff --cached --name-only --diff-filter=ACMRD -- 'content/blogs/*.md')
app_changed=$(git diff --cached --name-only --diff-filter=ACMRD -- 'app')

# Open Graph cards — regenerate when blog content changes (also prunes
# cards for deleted posts).
if [ -n "$blog_changed" ]; then
  echo "pre-commit: blog content changed, regenerating OG cards…"
  npm run og || {
    echo "pre-commit: OG generation failed; aborting commit." >&2
    exit 1
  }
  git add public/og
fi

# Static sitemap — regenerate when blog content or app routes change.
if [ -n "$blog_changed" ] || [ -n "$app_changed" ]; then
  echo "pre-commit: regenerating sitemap…"
  npm run sitemap || {
    echo "pre-commit: sitemap generation failed; aborting commit." >&2
    exit 1
  }
  git add public/sitemap.xml
fi

exit 0
